{
  "name": "videoeditor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:gpu": "node scripts/verify-gpu-contract.mjs",
    "verify:responsiveness": "node scripts/verify-responsiveness-contract.mjs",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && npx --yes electron-builder@26.0.12 --win nsis --x64"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.aatqabb.videoeditor",
    "productName": "Video Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "VideoEditor-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Video Editor"
    }
  }
}
