{
  "name": "videoeditor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:sfx": "node scripts/generate-sfx-assets.mjs",
    "build": "npm run generate:sfx && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:gpu": "node scripts/verify-gpu-contract.mjs",
    "verify:gpu:windows": "node scripts/verify-windows-gpu-export.cjs",
    "verify:microphone:windows": "npx electron scripts/verify-windows-microphone.cjs",
    "verify:responsiveness": "node scripts/verify-responsiveness-contract.mjs",
    "verify:timeline": "node scripts/verify-timeline-state.mjs",
    "verify:timeline-transform": "node scripts/verify-vite-transform-order.mjs",
    "verify:export": "node scripts/verify-export-contract.mjs",
    "verify:voiceover": "node scripts/verify-voiceover-contract.mjs",
    "verify:sfx": "node scripts/verify-sfx-contract.mjs",
    "verify:sfx-assets": "node scripts/verify-generated-sfx-assets.mjs",
    "verify:stock": "node scripts/verify-stock-workflow-contract.mjs",
    "verify:stock:live": "node scripts/verify-live-stock.mjs",
    "verify:windows-picker": "node scripts/verify-windows-native-picker.mjs",
    "verify:windows:acceptance": "node scripts/verify-windows-acceptance.cjs",
    "verify:final": "node scripts/verify-final-regression.mjs",
    "desktop": "npm run build && electron .",
    "prepare:ffmpeg:win": "node scripts/prepare-windows-ffmpeg.cjs",
    "package:win": "npm run prepare:ffmpeg:win && npm run build && npx --yes electron-builder@26.0.12 --win nsis --x64"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.aatqabb.videoeditor",
    "productName": "Video Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe",
          "README.txt"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VideoEditor-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Video Editor"
    }
  }
}
